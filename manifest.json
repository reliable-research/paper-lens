{
  "manifest_version": 3,
  "name": "Paper Lens \u2014 Read the argument",
  "version": "0.1.0",
  "description": "Read full PDFs with anchored core passages, explanations and notes. Includes Monitoring Monitorability.",
  "minimum_chrome_version": "140",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://arxiv.org/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Open PDF in Paper Lens"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self';"
  }
}
